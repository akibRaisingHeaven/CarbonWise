<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:ignore="HardcodedText,ButtonStyle,TextContrastCheck">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Configuration"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Green Energy Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Green Electricity Percentage (%)"
            android:textColor="#334155"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etGreenPercent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="e.g. 15.0"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />

            <Button
                android:id="@+id/btnAutoDetectGrid"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#1D4ED8"
                android:text="🌐 Live Grid" />
        </LinearLayout>

        <!-- Carbon Budget Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Daily Carbon Budget Goal"
            android:textColor="#334155"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spBudgetTier"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:popupBackground="#FFFFFF" />

        <EditText
            android:id="@+id/etCustomBudget"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="Custom Daily Budget (kg CO₂)"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:visibility="gone" />

        <!-- Live Tracker Notification Section -->
        <CheckBox
            android:id="@+id/cbEnableLiveTracker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="Enable Persistent Live Tracker Notification"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <!-- Reminders Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Reminders &amp; Reports Schedule"
            android:textColor="#334155"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbEnableDailyReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Daily Logging Reminder"
            android:textColor="#0F172A" />

        <Button
            android:id="@+id/btnDailyReminderTime"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⏰ Daily Time: 8:00 PM"
            android:textColor="#1D4ED8" />

        <CheckBox
            android:id="@+id/cbEnableWeeklyReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Weekly Summary Report"
            android:textColor="#0F172A" />

        <Spinner
            android:id="@+id/spWeeklyDay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:popupBackground="#FFFFFF" />

        <Button
            android:id="@+id/btnWeeklyReportTime"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⏰ Weekly Time: 8:00 PM"
            android:textColor="#1D4ED8" />

        <CheckBox
            android:id="@+id/cbEnableMonthlyReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Monthly Summary Report"
            android:textColor="#0F172A" />

        <Spinner
            android:id="@+id/spMonthlyDay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:popupBackground="#FFFFFF" />

        <Button
            android:id="@+id/btnMonthlyReportTime"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⏰ Monthly Time: 8:00 PM"
            android:textColor="#1D4ED8" />

        <!-- Owned Appliances Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Owned Appliances &amp; Custom Wattage"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/containerApplianceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- Bottom Action Buttons -->
        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#059669"
            android:text="Save &amp; Continue"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnReturnDashboard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1D4ED8"
            android:text="← Return to Dashboard"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>