<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8FAFC"
    tools:ignore="HardcodedText,ButtonStyle,TextContrastCheck,VisualLintButtonSize,VisualLintBounds">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDialogHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log New Activity"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Category"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:popupBackground="#FFFFFF" />

        <!-- Electricity Input Layout -->
        <LinearLayout
            android:id="@+id/layoutElectricity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appliance"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spAppliance"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:popupBackground="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hours Used"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHoursUsed"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="e.g. 2.5"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />
        </LinearLayout>

        <!-- Transport Input Layout -->
        <LinearLayout
            android:id="@+id/layoutTransport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transport Mode"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spTransportMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:popupBackground="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Origin"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etOrigin"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Origin"
                    android:maxLines="1"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8" />

                <Button
                    android:id="@+id/btnPickOriginMap"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:text="🗺 Map" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Destination"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDestination"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Destination"
                    android:maxLines="1"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8" />

                <Button
                    android:id="@+id/btnPickDestMap"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:text="🗺 Map" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCalculateDistance"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Calculate Distance" />

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Distance (km)"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDistance"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="Distance in km"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />

            <TextView
                android:id="@+id/tvCalculatedCo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#1D4ED8"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Meals Input Layout -->
        <LinearLayout
            android:id="@+id/layoutMeals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meal Diet Type"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spMealType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:popupBackground="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Portion Size"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spPortionSize"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:popupBackground="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Waste &amp; Leftovers Status"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spWasteOption"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:popupBackground="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Overhead &amp; Add-ons"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbTakeoutPackaging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Takeout / Food Delivery (+0.35 kg CO₂)"
                android:textColor="#0F172A"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbDairyBeverage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Dairy Beverage / Milk Latte (+0.40 kg CO₂)"
                android:textColor="#0F172A"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbSoftDrink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Soft Drink / Bottled Soda (+0.18 kg CO₂)"
                android:textColor="#0F172A"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Meal Count"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMealCount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="e.g. 1"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />
        </LinearLayout>

        <!-- Dedicated Cooking Fuel Layout -->
        <LinearLayout
            android:id="@+id/layoutCooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fuel Type"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spCookingFuel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:popupBackground="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cooking Hours"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCookingHours"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="e.g. 1.5"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />
        </LinearLayout>

        <!-- Submit Buttons -->
        <Button
            android:id="@+id/btnSubmitLog"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1D4ED8"
            android:text="Calculate &amp; Log"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCancelDialog"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textColor="#64748B" />

    </LinearLayout>
</ScrollView>