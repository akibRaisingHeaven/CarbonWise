<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activity Category"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <!-- Electricity Form -->
        <LinearLayout
            android:id="@+id/layoutElectricity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Appliance"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spAppliance"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvHoursUsedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hours Used Today (0.1 - 24.0)"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHoursUsed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="e.g. 3.5"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />
        </LinearLayout>

        <!-- Transport Form -->
        <LinearLayout
            android:id="@+id/layoutTransport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transport Mode"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spTransportMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Distance Traveled (km)"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="e.g. 12.5"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />
        </LinearLayout>

        <!-- Meals Form -->
        <LinearLayout
            android:id="@+id/layoutMeals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meal Type"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spMealType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Meal Count"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMealCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="e.g. 2"
                android:inputType="number"
                android:minHeight="48dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>