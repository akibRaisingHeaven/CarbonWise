<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="8dp">
    <TextView android:id="@+id/tvWidgetHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🌿 CarbonWise · Today" android:textColor="#BFDBFE" android:textSize="10sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvWidgetTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="1dp" android:text="0.0 kg CO₂" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvWidgetBudget" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="1dp" android:text="of 8.0 kg budget · 0% used" android:textColor="#DBEAFE" android:textSize="9sp"/>
    <ProgressBar android:id="@+id/pbWidgetBudget" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="4dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress"/>
    <TextView android:id="@+id/tvWidgetRemaining" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:text="8.0 kg CO₂ remaining" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/tvWidgetStatus" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="✓ On track" android:textColor="#BBF7D0" android:textSize="10sp" android:textStyle="bold"/>
        <TextView android:id="@+id/btnWidgetQuickLog" android:layout_width="wrap_content" android:layout_height="24dp"
            android:background="@drawable/widget_action_background" android:gravity="center" android:paddingHorizontal="7dp"
            android:text="+ Log" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
