            <TextView android:id="@+id/tvLogSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#64748B" android:textSize="13sp" tools:text="Electricity • Nov 7, 2026"/>
